# Connection string dari Neon (Settings > Connection Details)
# Pastikan menyertakan ?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require

# Secret untuk sign JWT, ganti dengan string acak yang kuat
JWT_SECRET=ganti-dengan-secret-yang-kuat
JWT_EXPIRES_IN=1d

PORT=3000
