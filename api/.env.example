# ============================================
# PixTale API Environment Configuration
# ============================================

PORT=3000
NODE_ENV=development

# --------------------------------------------
# 1. PostgreSQL Lokal (Default)
# --------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixtale
DATABASE_SSL=false

# Opsional parameter individual jika tidak menggunakan DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pixtale
DB_USER=postgres
DB_PASSWORD=postgres

# --------------------------------------------
# 2. Alternatif: PostgreSQL Cloud / Neon
# --------------------------------------------
# Jika ingin beralih ke Neon, aktifkan format di bawah (sertakan sslmode=require)
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
# DATABASE_SSL=true

# --------------------------------------------
# JWT Authentication
# --------------------------------------------
JWT_SECRET=pixtale-super-secret-local-jwt-token-2026
JWT_EXPIRES_IN=1d
